# Copy to .env.local for local development. Never commit real values.
# Every external service is optional locally; leave placeholders empty to use local defaults.

# --- Core ---------------------------------------------------------------
# Public URL of the app (used in emails and certificate links).
APP_URL=http://localhost:3000
# Postgres (docker compose default). Production: Neon/Supabase URL via Cloudflare Hyperdrive.
DATABASE_URL=postgres://lms:lms_local_only@localhost:5432/lms
# Long random string: `openssl rand -base64 32`. Required in production; local dev uses a fixed fallback.
AUTH_SECRET=
# Comma-separated emails that become admins when they first sign in.
ADMIN_EMAILS=

# --- Email: Resend (placeholder) -----------------------------------------
# Empty → emails go to Mailpit on localhost:1025 (see http://localhost:8025).
RESEND_API_KEY=
EMAIL_FROM="AI Engineering Handbook <no-reply@example.com>"

# --- Google sign-in (placeholder) ----------------------------------------
# Empty → the Google button is hidden. Create at console.cloud.google.com → Credentials.
# Authorised redirect URI: ${APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Error tracking: Sentry (placeholder) ---------------------------------
# Empty → errors are logged to stdout only.
SENTRY_DSN=

# --- Domain / Cloudflare (placeholder, used by CI deploy in M6) ----------
APP_DOMAIN=
CLOUDFLARE_ACCOUNT_ID=
# Set CLOUDFLARE_API_TOKEN as a GitHub Actions secret, not here.

# --- Content publishing from the admin screen (optional) ----------------
# Fine-grained GitHub token with contents:write on this repository only.
GITHUB_PUBLISH_TOKEN=
GITHUB_REPOSITORY=abzanofficial-ai/ai-engineering-course
# Branch the admin screen commits to; CI builds and deploys from it.
GITHUB_PUBLISH_BRANCH=main

# --- Web push (M5, ADR-0022). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Payments (later, behind flag payments.stripe) -----------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
